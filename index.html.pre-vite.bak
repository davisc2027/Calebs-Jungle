const CASTLE_WALLS = [
  {minX:-22.6,maxX:22.6, minZ:-22.6,maxZ:-21, maxH:12},  // north wall
  {minX:-22,  maxX:-2.6, minZ:21,   maxZ:22.6, maxH:12},  // south wall left
  {minX:2.6,  maxX:22,   minZ:21,   maxZ:22.6, maxH:12},  // south wall right
